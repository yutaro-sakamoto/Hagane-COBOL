AT_SETUP([CALL and CANCEL program with national PROGRAM-ID])

AT_DATA([callee.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      ƒeƒXƒg.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01 CNT           PIC 9 VALUE 0.
       PROCEDURE        DIVISION.
           ADD 1 TO CNT.
           DISPLAY "IN CALLEE " CNT.
           GOBACK.
])

AT_DATA([caller.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      caller.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01 WS-NAME       PIC X(20) VALUE "ƒeƒXƒg".
       PROCEDURE        DIVISION.
           CALL "ƒeƒXƒg".
           CALL WS-NAME.
           CANCEL WS-NAME.
           CALL "ƒeƒXƒg".
           CANCEL "ƒeƒXƒg".
           CALL WS-NAME.
           STOP RUN.
])

AT_CHECK([${COMPILE} callee.cob])
AT_CHECK([${COMPILE} caller.cob])
AT_CHECK([java caller], [0],
[IN CALLEE 1
IN CALLEE 2
IN CALLEE 1
IN CALLEE 1
])

AT_CLEANUP
